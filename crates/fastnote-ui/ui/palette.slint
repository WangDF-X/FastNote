export global ShellPalette {
    in-out property <bool> dark: false;

    // SET-02：只切换界面/标题栏/悬浮球的既有品牌资产，任务栏和托盘保持原样。
    out property <image> brand-icon: dark ? @image-url("../../../ui/branding/fastnote-app-icon-reversed.svg") : @image-url("../../../ui/branding/fastnote-app-icon.svg");
    out property <image> brand-icon-small: dark ? @image-url("../../../ui/branding/fastnote-app-icon-reversed.svg") : @image-url("../../../ui/branding/fastnote-app-icon-small.svg");

    out property <color> canvas: dark ? #101215 : #F6F7F9;
    out property <color> surface: dark ? #171A1E : #FFFFFF;
    out property <color> subtle: dark ? #1F2328 : #EEF0F3;
    out property <color> hover: dark ? #23282E : #F2F4F7;
    out property <color> selected: dark ? #1D2A45 : #E8EFFD;
    out property <color> border: dark ? #2A2F36 : #E1E5EA;
    out property <color> text-primary: dark ? #E7EAF0 : #1B1F24;
    out property <color> text-secondary: dark ? #A3ACB8 : #59616C;
    out property <color> text-tertiary: dark ? #75808C : #87909B;
    out property <color> accent: dark ? #6E9BFF : #2E6BE6;
    out property <color> danger: dark ? #E46A61 : #C93B32;
    out property <color> danger-subtle: dark ? #3A211F : #FFF1F0;
    out property <color> success: dark ? #52B98A : #23835B;
    out property <color> warning: dark ? #D9A03C : #A86400;
    out property <color> overlay: dark ? #0000008C : #0F121659;
    out property <color> shadow: dark ? #00000066 : #1418201F;
    out property <color> on-accent: dark ? #101215 : #FFFFFF;

    // D-TODAY-04：四态使用轻量背景色，选中描边不覆盖真实状态色。
    out property <color> task-todo: dark ? #1D2026 : #F4F5F7;
    out property <color> task-progress: dark ? #1B2535 : #EEF4FF;
    out property <color> task-waiting: dark ? #2C261C : #FFF6E8;
    out property <color> task-done: dark ? #1B2B23 : #EDF7F1;
}
