import { ScrollView } from "std-widgets.slint";
import { TaskSelect } from "../tasks/task-select.slint";
import { TaskStyle } from "../tasks/task-style.slint";
import { ShellPalette } from "../palette.slint";
import { VisibilitySwitch } from "visibility-switch.slint";

/// SET-03：只展示已提交偏好；同一动作入口负责保存、失败反馈及今日重查。
export component TaskPreferences inherits Rectangle {
    in property <int> sort-index;
    in property <bool> show-in-progress;
    in property <bool> show-waiting;
    in property <bool> show-unscheduled;
    in property <bool> show-completed;
    in property <bool> enabled: true;
    in property <bool> busy: false;
    in property <string> error-message;
    callback action(string);
    background: transparent;
    scroll := ScrollView {
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        content-width: self.visible-width;
        content-height: max(self.visible-height, body.preferred-height);
        body := VerticalLayout {
            width: scroll.visible-width;
            padding: 24px; spacing: 16px;
            Text { text: "任务偏好"; font-size: TaskStyle.heading; font-family: TaskStyle.font-family; font-weight: 600; color: ShellPalette.text-primary; }
            if root.error-message != "": Text {
                text: root.error-message; wrap: word-wrap;
                font-size: TaskStyle.caption; font-family: TaskStyle.font-family; color: ShellPalette.danger;
            }
            Rectangle {
                height: 100px;
                border-radius: TaskStyle.card-radius;
                border-width: 1px; border-color: ShellPalette.border;
                background: ShellPalette.surface;
                HorizontalLayout {
                    padding: 16px; spacing: 16px; cross-axis-alignment: center;
                    VerticalLayout {
                        horizontal-stretch: 1; spacing: 8px;
                        Text { text: "今日排序"; font-size: TaskStyle.body; font-family: TaskStyle.font-family; color: ShellPalette.text-primary; }
                        Text { text: "仅调整逾期、今日到期、今日开始和进行中。"; wrap: word-wrap; font-size: TaskStyle.caption; font-family: TaskStyle.font-family; color: ShellPalette.text-secondary; }
                    }
                    TaskSelect {
                        min-width: 144px; max-width: 144px;
                        model: ["优先级", "到期时间", "最近创建"];
                        current-index: root.sort-index;
                        label: "今日任务默认排序"; focus-key: "settings:tasks:sort";
                        enabled: root.enabled && !root.busy;
                        selected(index) => {
                            root.action("settings:tasks:sort:" + ["priority", "due_date", "created_desc"][index]);
                        }
                    }
                }
            }
            Text { text: "显示分组"; font-size: TaskStyle.body; font-family: TaskStyle.font-family; color: ShellPalette.text-primary; }
            Rectangle {
                height: 243px;
                border-radius: TaskStyle.card-radius;
                border-width: 1px; border-color: ShellPalette.border;
                background: ShellPalette.surface;
                VerticalLayout {
                    padding: 8px; spacing: 0px;
                    VisibilitySwitch {
                        label: "进行中"; description: "跨天进行的任务";
                        checked: root.show-in-progress; enabled: root.enabled && !root.busy;
                        focus-key: "settings:tasks:in-progress";
                        toggled(shown) => { root.action("settings:tasks:in-progress:" + (shown ? "true" : "false")); }
                    }
                    Rectangle { height: 1px; background: ShellPalette.border; }
                    VisibilitySwitch {
                        label: "等待中"; description: "等待反馈或后续处理的任务";
                        checked: root.show-waiting; enabled: root.enabled && !root.busy;
                        focus-key: "settings:tasks:waiting";
                        toggled(shown) => { root.action("settings:tasks:waiting:" + (shown ? "true" : "false")); }
                    }
                    Rectangle { height: 1px; background: ShellPalette.border; }
                    VisibilitySwitch {
                        label: "未安排"; description: "未设置开始或到期日期的任务";
                        checked: root.show-unscheduled; enabled: root.enabled && !root.busy;
                        focus-key: "settings:tasks:unscheduled";
                        toggled(shown) => { root.action("settings:tasks:unscheduled:" + (shown ? "true" : "false")); }
                    }
                    Rectangle { height: 1px; background: ShellPalette.border; }
                    VisibilitySwitch {
                        label: "今日已完成"; description: "本地今天完成的任务";
                        checked: root.show-completed; enabled: root.enabled && !root.busy;
                        focus-key: "settings:tasks:completed";
                        toggled(shown) => { root.action("settings:tasks:completed:" + (shown ? "true" : "false")); }
                    }
                }
            }
            Text { text: "隐藏只影响显示，不删除任务，也不改变分组规则。"; wrap: word-wrap; font-size: TaskStyle.caption; font-family: TaskStyle.font-family; color: ShellPalette.text-secondary; }
            Text { text: root.busy ? "正在保存…" : ""; font-size: TaskStyle.caption; font-family: TaskStyle.font-family; color: ShellPalette.text-secondary; }
            Rectangle { vertical-stretch: 1; }
        }
    }
}
