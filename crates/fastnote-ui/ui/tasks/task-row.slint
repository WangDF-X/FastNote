import { TaskRowData } from "types.slint";
import { TaskIconButton } from "icon-button.slint";
import { ShellPalette } from "../palette.slint";
import { ShellFocus } from "../shell-focus.slint";
import { TaskSelect } from "task-select.slint";
import { TaskStyle } from "task-style.slint";

export component TaskRow inherits Rectangle {
    in property <TaskRowData> data;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback opened();
    callback dates-requested();
    callback toggled();
    callback deleted();
    callback priority-changed();
    callback status-changed(int);
    callback focus-moved(int);

    height: TaskStyle.row-height;
    horizontal-stretch: 1;
    background: TaskStyle.row-background(root.data.status-index, root.data.overdue, body-mouse.has-hover, body-mouse.pressed);
    animate background { duration: 120ms; }
    border-radius: TaskStyle.row-radius;
    border-width: 1px;
    border-color: ShellFocus.show-indicators && root.selected ? ShellPalette.accent : transparent;
    private property <int> focus-tick: ShellFocus.restore-tick;
    private property <bool> focused: body-keyboard.has-focus;
    private property <bool> status-focused: status-choice.has-focus;
    changed status-focused => { if (status-focused) { ShellFocus.claim("task:status:" + root.data.id); } }
    changed focused => { if (focused) { ShellFocus.claim("task:" + root.data.id); } }
    changed focus-tick => {
        if (ShellFocus.anchor == "task:" + root.data.id) { body-keyboard.focus(); }
        else if (ShellFocus.anchor == "task:status:" + root.data.id) { status-choice.focus(); }
        else if (ShellFocus.anchor == "task:date:" + root.data.id) { date-keyboard.focus(); }
    }

    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 8px;
        // 必须使用 stretch：center 不分配剩余宽度，会把无固有宽度的标题区域压成 0。
        alignment: stretch;
        cross-axis-alignment: center;
        TaskIconButton {
            checkbox: true;
            checked: root.data.done;
            foreground: root.data.status-index == 1 ? ShellPalette.accent : ShellPalette.text-secondary;
            label: (root.data.done ? "重新打开：" : "完成：") + root.data.title;
            focus-key: "task:check:" + root.data.id;
            enabled: root.enabled && !root.data.read-only;
            activated => { root.toggled(); }
        }
        body := Rectangle {
            horizontal-stretch: 1;
            min-width: 180px;
            preferred-width: 320px;
            height: TaskStyle.row-height;
            forward-focus: body-keyboard;
            accessible-role: button;
            accessible-label: root.data.title + "，" + root.data.status-label + (root.data.overdue ? "，逾期" : "");
            accessible-action-default => { if (root.enabled) { root.opened(); } }
            title := Text {
                x: 4px; y: root.data.today-context == "" && root.data.blocking-label == "" ? 16px : 8px;
                width: max(0px, parent.width - (root.data.overdue ? 78px : 8px)); height: 20px;
                text: root.data.title;
                color: ShellPalette.text-primary;
                font-size: TaskStyle.body; font-family: TaskStyle.font-family; overflow: elide; vertical-alignment: center;
            }
            if root.data.overdue: Rectangle {
                x: title.x + min(title.width, title.preferred-width) + 8px; y: title.y;
                width: 62px; height: 20px;
                Image {
                    x: 0px; y: 2px; width: TaskStyle.icon-size; height: TaskStyle.icon-size;
                    source: @image-url("../../../../ui/icons/alert.svg");
                    colorize: TaskStyle.row-danger; accessible-role: none;
                }
                Text {
                    x: 19px; width: parent.width - 19px; height: parent.height;
                    text: "已逾期"; color: ShellPalette.text-secondary;
                    font-size: TaskStyle.caption; font-family: TaskStyle.font-family; vertical-alignment: center;
                }
            }
            if root.data.done: Rectangle {
                x: title.x; y: title.y + 10px;
                width: min(title.width, title.preferred-width); height: 1px;
                background: ShellPalette.text-primary;
            }
            Text {
                x: 4px; y: 30px;
                width: parent.width - self.x - 4px; height: 16px;
                text: root.data.today-context + (root.data.today-context != "" && root.data.blocking-label != "" ? " · " : "") + root.data.blocking-label;
                color: ShellPalette.text-secondary;
                font-size: TaskStyle.caption; font-family: TaskStyle.font-family; overflow: elide;
            }
            Rectangle {
                x: 0px; y: 2px; width: parent.width; height: parent.height - 4px;
                border-width: 2px; border-radius: 4px; border-color: ShellPalette.accent;
                background: transparent; visible: ShellFocus.show-indicators && body-keyboard.has-focus;
            }
            body-keyboard := FocusScope {
                x: 0px; y: 0px;
                width: parent.width; height: parent.height;
                enabled: root.enabled;
                key-pressed(event) => {
                    if (event.text == Key.Return) { root.opened(); return accept; }
                    if (event.text == " " && !root.data.read-only) { root.toggled(); return accept; }
                    if ((event.text == Key.Delete || event.text == Key.Backspace) && !root.data.read-only) { root.deleted(); return accept; }
                    if (event.text == Key.UpArrow) { root.focus-moved(-1); return accept; }
                    if (event.text == Key.DownArrow) { root.focus-moved(1); return accept; }
                    return reject;
                }
                body-mouse := TouchArea {
                    enabled: root.enabled; mouse-cursor: pointer;
                    clicked => { body-keyboard.focus(); root.opened(); }
                }
            }
            if root.data.blocking-label != "": TouchArea {
                x: 0px; y: 28px; width: parent.width; height: 20px;
                mouse-cursor: pointer;
                clicked => { root.opened(); }
                changed has-hover => { if (self.has-hover) { blockers.show(); } else { blockers.close(); } }
                blockers := PopupWindow {
                    x: 0px; y: 20px; width: 300px;
                    height: min(260px, blocker-text.preferred-height + 20px);
                    close-policy: no-auto-close;
                    Rectangle {
                        background: ShellPalette.surface; border-width: 1px; border-color: ShellPalette.border; border-radius: 6px;
                        blocker-text := Text {
                            x: 10px; y: 10px; width: parent.width - 20px; height: parent.height - 20px;
                            text: root.data.blocking-tooltip; wrap: word-wrap; overflow: elide;
                            color: ShellPalette.text-primary; font-size: TaskStyle.caption; font-family: TaskStyle.font-family;
                        }
                    }
                }
            }
        }
        status-choice := TaskSelect {
            min-width: 90px;
            max-width: 90px;
            preferred-width: 90px;
            model: ["未开始", "进行中", "已完成"];
            current-index: root.data.done ? 2 : root.data.status-index;
            enabled: root.enabled && !root.data.read-only;
            label: "修改任务状态：" + root.data.title;
            focus-key: "task:status:" + root.data.id;
            selected(index) => { root.status-changed(index); }
        }
        date-entry := Rectangle {
            width: 160px; height: 44px; border-radius: 6px;
            background: date-mouse.pressed ? ShellPalette.subtle : date-mouse.has-hover ? ShellPalette.hover : transparent;
            accessible-role: button;
            accessible-label: "设置日期：" + root.data.title + (root.data.start-label != "" ? "，开始 " + root.data.start-label : "") + (root.data.due-label != "" ? "，到期 " + root.data.due-label : "");
            accessible-action-default => { if (root.enabled) { root.dates-requested(); } }
            Image { x: 4px; y: 14px; width: 16px; height: 16px; source: @image-url("../../../../ui/icons/calendar.svg"); colorize: ShellPalette.text-secondary; accessible-role: none; }
            Text {
                x: 24px; y: 2px; width: parent.width - 28px; height: parent.height - 4px;
                text: root.data.start-label == "" && root.data.due-label == "" ? "设置日期" : root.data.start-label + (root.data.start-label != "" && root.data.due-label != "" ? "\n" : "") + root.data.due-label;
                color: ShellPalette.text-secondary; font-size: TaskStyle.caption; font-family: root.data.start-label == "" && root.data.due-label == "" ? TaskStyle.font-family : TaskStyle.date-font-family; vertical-alignment: center; overflow: elide;
            }
            Rectangle {
                width: parent.width; height: parent.height; border-radius: 6px;
                border-width: 2px; border-color: ShellPalette.accent; background: transparent;
                visible: ShellFocus.show-indicators && date-keyboard.has-focus;
            }
            date-keyboard := FocusScope {
                width: parent.width; height: parent.height; enabled: root.enabled;
                changed has-focus => { if (self.has-focus) { ShellFocus.claim("task:date:" + root.data.id); } }
                key-pressed(event) => { if (event.text == Key.Return || event.text == " ") { root.dates-requested(); return accept; } return reject; }
                date-mouse := TouchArea { mouse-cursor: pointer; clicked => { date-keyboard.focus(); root.dates-requested(); } }
            }
        }
        TaskIconButton {
            glyph: root.data.priority-label;
            glyph-with-icon: true; icon: @image-url("../../../../ui/icons/flag.svg");
            label: "切换优先级（当前" + root.data.priority-label + "）：" + root.data.title;
            foreground: root.data.priority == 3 ? TaskStyle.row-danger : root.data.priority == 2 ? TaskStyle.row-warning : ShellPalette.text-secondary;
            focus-key: "task:priority:" + root.data.id;
            enabled: root.enabled && !root.data.read-only;
            activated => { root.priority-changed(); }
        }
        TaskIconButton {
            icon: @image-url("../../../../ui/icons/trash.svg");
            label: "删除：" + root.data.title;
            foreground: TaskStyle.row-danger;
            focus-key: "task:delete:" + root.data.id;
            enabled: root.enabled && !root.data.read-only;
            activated => { root.deleted(); }
        }
    }
}
