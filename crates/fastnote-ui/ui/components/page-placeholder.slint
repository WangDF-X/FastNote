import { ShellPalette } from "../palette.slint";

export component PagePlaceholder inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> description;

    height: 158px;
    background: transparent;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 56px;
            background: transparent;
            Image {
                x: (parent.width - self.width) / 2;
                width: 40px;
                height: 40px;
                source: root.icon;
                colorize: ShellPalette.text-tertiary;
                accessible-role: none;
            }
        }

        Text {
            height: 22px;
            text: root.title;
            font-size: 15px;
            font-weight: 600;
            color: ShellPalette.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle { height: 8px; background: transparent; }

        Text {
            height: 40px;
            text: root.description;
            font-size: 13px;
            color: ShellPalette.text-secondary;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle { height: 16px; background: transparent; }

        Text {
            height: 16px;
            text: "开发占位 · 尚未接入业务功能";
            font-size: 11px;
            color: ShellPalette.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
