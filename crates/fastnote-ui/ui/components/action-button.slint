import { ShellPalette } from "../palette.slint";
import { ShellFocus } from "../shell-focus.slint";

/// ARCH-05 §5.1：Primary / Secondary / Danger 按钮，高 32、圆角 6。
export component ActionButton inherits Rectangle {
    in property <string> label;
    /// 可选的统一线性图标；未指定时不预留图标空间。
    in property <image> icon;
    in property <bool> with-icon: false;
    /// 默认不旋转；成对方向按钮可复用同一矢量图标。
    in property <angle> icon-rotation: 0deg;
    in property <length> text-size: 14px;
    in property <string> text-family: "";
    in property <color> text-color: ShellPalette.text-primary;
    /// 语义色可只作用于图标，不必改变按钮文字。
    in property <color> icon-color: root.text-color;
    /// 低强调行操作，保留 hover 和实际焦点，不绘制常驻按钮边框。
    in property <bool> ghost: false;
    in property <bool> left-aligned: false;
    /// 强调色实心按钮。
    in property <bool> primary: false;
    /// 危险色实心按钮，用于删除等破坏性操作（SHELL-02 §6.1）。
    in property <bool> danger: false;
    in property <bool> enabled: true;
    /// 焦点锚点标识，用于对话框关闭后精确恢复焦点；空字符串表示不参与。
    in property <string> focus-key: "";
    /// 供对话框做初始聚焦与 Tab 循环判断。
    out property <bool> focused: keyboard.has-focus;
    callback activated();

    private property <bool> filled: primary || danger;
    private property <color> fill-color: danger ? ShellPalette.danger : ShellPalette.accent;
    private property <int> focus-tick: ShellFocus.restore-tick;
    private property <bool> keyboard-focused: keyboard.has-focus;
    private property <length> icon-space: root.with-icon ? 22px : 0px;
    private property <length> content-width: min(root.width - 24px, label-text.preferred-width + root.icon-space);
    private property <length> content-x: root.left-aligned ? 12px : (root.width - root.content-width) / 2;

    changed keyboard-focused => {
        if (keyboard-focused) {
            ShellFocus.claim(root.focus-key);
        }
    }

    changed focus-tick => {
        if (root.focus-key != "" && ShellFocus.anchor == root.focus-key) {
            keyboard.focus();
        }
    }

    /// 让外部（如 DialogHost）把键盘焦点移到这个按钮上。
    public function focus-button() {
        keyboard.focus();
    }

    height: 32px;
    width: max(72px, label-text.preferred-width + 32px + root.icon-space);
    border-radius: 6px;
    border-width: filled || root.ghost ? 0px : 1px;
    border-color: ShellPalette.border;
    background: filled ? (mouse-area.pressed ? fill-color.darker(ShellPalette.dark ? 0.1 : 0.25) : mouse-area.has-hover ? fill-color.darker(ShellPalette.dark ? 0.05 : 0.1) : fill-color) : (mouse-area.pressed ? ShellPalette.subtle : mouse-area.has-hover ? ShellPalette.hover : root.ghost ? transparent : ShellPalette.surface);
    animate background { duration: 120ms; }
    opacity: enabled ? 1 : 0.45;
    forward-focus: keyboard;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => {
        if (root.enabled) {
            root.activated();
        }
    }

    if root.with-icon: Image {
        x: root.content-x;
        y: (parent.height - 16px) / 2;
        width: 16px; height: 16px;
        source: root.icon;
        transform-rotation: root.icon-rotation;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        colorize: root.filled ? ShellPalette.on-accent : root.icon-color;
        accessible-role: none;
    }
    label-text := Text {
        x: root.content-x + root.icon-space;
        y: (parent.height - 20px) / 2;
        width: max(0px, root.content-width - root.icon-space);
        height: 20px;
        text: root.label;
        font-size: root.text-size;
        font-family: root.text-family;
        font-weight: 500;
        color: root.filled ? ShellPalette.on-accent : root.text-color;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }

    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 8px;
        border-width: 2px;
        border-color: ShellPalette.accent;
        background: transparent;
        visible: ShellFocus.show-indicators && keyboard.has-focus;
    }

    keyboard := FocusScope {
        x: 0px; y: 0px;
        width: parent.width; height: parent.height;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == "\n" || event.text == " ") {
                root.activated();
                return accept;
            }
            return reject;
        }

        mouse-area := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                keyboard.focus();
                root.activated();
            }
        }
    }
}
