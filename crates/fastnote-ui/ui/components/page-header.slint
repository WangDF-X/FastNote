import { ShellPalette } from "../palette.slint";
import { ShellControl } from "shell-control.slint";

/// SHELL-01 §3.3：64px 页面头部，标题、上下文、显式返回入口。
export component PageHeader inherits Rectangle {
    in property <string> title;
    in property <string> context;
    in property <bool> can-go-back: false;
    in property <string> back-focus-key;
    callback back();

    height: 64px;
    background: ShellPalette.canvas;
    forward-focus: title-focus;

    title-focus := FocusScope {
        x: 24px;
        y: root.context == "" ? 18px : 8px;
        width: parent.width - 144px;
        height: 28px;
        focus-on-tab-navigation: false;

        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: root.title;
            font-size: 20px;
            font-weight: 600;
            color: ShellPalette.text-primary;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    Text {
        visible: root.context != "";
        x: 24px;
        y: 39px;
        width: parent.width - 144px;
        height: 16px;
        text: root.context;
        font-size: 12px;
        color: ShellPalette.text-secondary;
        overflow: elide;
    }

    Text {
        visible: !root.can-go-back;
        x: parent.width - 84px;
        y: 24px;
        width: 60px;
        height: 16px;
        text: "外壳预览";
        font-size: 12px;
        color: ShellPalette.text-secondary;
        horizontal-alignment: right;
    }

    ShellControl {
        visible: root.can-go-back;
        x: parent.width - 116px;
        y: 16px;
        width: 92px;
        label: "返回";
        icon: @image-url("../../../../ui/icons/arrow-left.svg");
        focus-key: root.back-focus-key;
        activated => { root.back(); }
    }

    Rectangle {
        x: 0px;
        y: parent.height - 1px;
        height: 1px;
        width: parent.width;
        background: ShellPalette.border;
    }
}
