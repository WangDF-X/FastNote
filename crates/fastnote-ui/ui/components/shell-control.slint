import { ShellPalette } from "../palette.slint";
import { ShellFocus } from "../shell-focus.slint";

export component ShellControl inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> navigation: false;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    /// 焦点锚点标识，用于对话框关闭后精确恢复焦点；空字符串表示不参与。
    in property <string> focus-key: "";
    callback activated();

    private property <length> icon-size: navigation ? 18px : 16px;
    private property <color> foreground: selected ? ShellPalette.accent : ShellPalette.text-secondary;
    private property <int> focus-tick: ShellFocus.restore-tick;
    private property <bool> keyboard-focused: keyboard.has-focus;

    changed keyboard-focused => {
        if (keyboard-focused) {
            ShellFocus.claim(root.focus-key);
        }
    }

    changed focus-tick => {
        if (root.focus-key != "" && ShellFocus.anchor == root.focus-key) {
            keyboard.focus();
        }
    }

    height: navigation ? 40px : 32px;
    border-radius: navigation ? 8px : 6px;
    border-width: navigation ? 0px : 1px;
    border-color: ShellPalette.border;
    background: selected ? ShellPalette.selected : mouse-area.pressed ? ShellPalette.subtle : mouse-area.has-hover ? ShellPalette.hover : navigation ? transparent : ShellPalette.surface;
    opacity: enabled ? 1 : 0.45;
    forward-focus: keyboard;
    accessible-role: button;
    accessible-label: selected && navigation ? label + "，当前页面" : label;
    accessible-action-default => {
        if (root.enabled) {
            root.activated();
        }
    }

    if root.navigation && root.selected: Rectangle {
        x: 0px;
        y: 12px;
        width: 3px;
        height: 16px;
        border-radius: 2px;
        background: ShellPalette.accent;
    }

    Image {
        x: root.navigation ? 8px : 12px;
        y: (parent.height - self.height) / 2;
        width: root.icon-size;
        height: root.icon-size;
        source: root.icon;
        colorize: root.foreground;
        accessible-role: none;
    }

    Text {
        x: (root.navigation ? 8px : 12px) + root.icon-size + 8px;
        y: (parent.height - self.height) / 2;
        width: parent.width - self.x - 12px;
        height: 20px;
        text: root.label;
        color: root.foreground;
        font-size: 14px;
        font-weight: root.selected ? 600 : root.navigation ? 400 : 500;
        vertical-alignment: center;
        accessible-role: none;
    }

    Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-radius: root.navigation ? 6px : 4px;
        border-width: 2px;
        border-color: ShellPalette.accent;
        background: transparent;
        visible: ShellFocus.show-indicators && keyboard.has-focus;
    }

    keyboard := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == "\n" || event.text == " ") {
                root.activated();
                return accept;
            }
            return reject;
        }

        mouse-area := TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => {
                keyboard.focus();
                root.activated();
            }
        }
    }
}
