import { ShellPalette } from "palette.slint";
import { ShellFocus } from "shell-focus.slint";
import { ShellControl } from "components/shell-control.slint";
import { PagePlaceholder } from "components/page-placeholder.slint";
import { PageFrame } from "components/page-frame.slint";
import { SidebarDate } from "components/sidebar-date.slint";
import { PageState } from "components/page-state.slint";
import { ToastHost, ToastData, ToastTone } from "components/toast-host.slint";
import { DialogHost, DialogData, DialogTone } from "components/dialog-host.slint";
import { BannerData, BannerTone } from "components/page-banner.slint";
import { GeneralSettings } from "components/general-settings.slint";
import { SettingsWorkspace } from "settings/workspace.slint";
import { TaskPreferences } from "settings/task-preferences.slint";
import { FloatingBall, BallMenuWindow } from "floating-ball.slint";
import { TitleBar } from "components/title-bar.slint";
import { WindowOutline } from "components/window-outline.slint";
import { ThemeSwitch } from "components/theme-switch.slint";
import { TodayPage } from "tasks/today-page.slint";
import { TaskDrawer } from "tasks/task-drawer.slint";
import { TaskRowData, TodaySectionData, CalendarDayData } from "tasks/types.slint";
import { CalendarPage } from "calendar/page.slint";
import { CalendarCellView, CalendarSectionData } from "calendar/types.slint";
import { NotesPage, NoteRowData, NotePreviewBlock } from "notes/page.slint";
import { JournalPage, JournalRowData, JournalAttachmentView } from "journal/page.slint";
import { Palette, Date } from "std-widgets.slint";

export { BannerData, BannerTone, DialogData, DialogTone, ToastData, ToastTone, FloatingBall, BallMenuWindow, ShellPalette, ShellFocus, Palette, Date, TaskRowData, TodaySectionData, CalendarDayData, CalendarCellView, CalendarSectionData, NoteRowData, NotePreviewBlock }

struct PagePresentation {
    label: string,
    icon: image,
    description: string,
    empty-title: string,
    empty-description: string,
    empty-action: string,
}

export component MainWindow inherits Window {
    title: "FastNote";
    // 标题栏图标（winit 只设置 ICON_SMALL）；任务栏/Alt+Tab 由
    // fastnote-platform::set_window_big_icon 从 exe 资源补齐。
    icon: ShellPalette.brand-icon;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1024px;
    min-height: 680px;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    background: ShellPalette.canvas;
    no-frame: root.custom-titlebar;
    resize-border-width: root.window-maximized ? 0px : 6px;
    in property <bool> custom-titlebar: true;
    in property <bool> window-maximized: false;
    in property <bool> window-active: true;
    private property <length> caption-height: root.custom-titlebar ? 40px : 0px;

    in property <string> current_page: "今日任务";
    in property <string> calendar-heading;
    in property <string> calendar-selected-label;
    in property <string> calendar-selected-context;
    in property <string> calendar-panel-message;
    in property <[CalendarSectionData]> calendar-panel-sections;
    in property <string> calendar-error;
    in property <[string]> calendar-weekdays;
    in property <[CalendarCellView]> calendar-days;
    in property <bool> calendar-week-mode;
    in property <bool> calendar-panel-open;
    callback calendar-action(string);
    callback calendar-select-date(string);
    in property <[NoteRowData]> note-rows;
    in property <int> note-total;
    in property <string> note-selected-id;
    in property <string> note-current-name;
    in property <string> note-selected-path;
    in property <bool> note-can-back;
    in property <bool> note-can-forward;
    in property <bool> note-can-parent;
    in property <int> note-reveal-index;
    in property <int> note-reveal-tick;
    in property <string> note-error;
    in property <string> note-save-label;
    in property <bool> note-has-selection;
    in property <bool> note-preview-mode;
    private property <bool> note-shortcut-blocked;
    in property <[NotePreviewBlock]> note-preview-blocks;
    in property <string> note-preview-warning;
    in-out property <string> note-content;
    in-out property <string> note-create-name;
    in property <string> note-create-error;
    in property <bool> note-create-busy;
    in-out property <bool> note-create-open;
    in-out property <bool> note-create-folder;
    in property <string> note-rename-id;
    in-out property <string> note-rename-name;
    in property <string> note-rename-error;
    in property <string> note-create-path;
    in property <string> note-created-date;
    in property <string> note-updated-date;
    callback note-create(string);
    callback note-create-start(string, bool);
    callback note-open(string);
    callback note-select-entry(string);
    callback note-toggle-folder(string);
    callback note-navigate(string);
    callback note-rename-start(string);
    callback note-rename-submit(string);
    callback note-rename-cancel();
    callback note-delete(string);
    callback note-undo();
    callback note-move(string, string);
    in property <bool> note-undo-visible;
    callback note-edit(string);
    callback note-flush();
    callback note-discard();
    callback note-toggle-preview();
    callback note-open-link(string);
    in property <[JournalRowData]> journal-rows;
    in property <string> journal-period-label;
    in property <bool> journal-week-mode;
    in property <bool> journal-empty;
    in property <bool> journal-has-today;
    in property <string> journal-date-label;
    in property <string> journal-selected-date;
    in property <bool> journal-editing;
    in-out property <string> journal-content;
    in property <string> journal-save-label;
    in property <string> journal-error;
    in property <bool> journal-preview-mode;
    in property <[NotePreviewBlock]> journal-preview-blocks;
    in property <[JournalAttachmentView]> journal-attachments;
    in property <string> journal-image-usage;
    in property <bool> journal-add-image-busy;
    in property <bool> journal-pending-image;
    in property <string> journal-pending-image-label;
    in property <bool> journal-viewer-visible;
    in property <image> journal-viewer-image;
    in property <string> journal-viewer-title;
    in property <bool> journal-viewer-loading;
    in property <int> journal-viewer-index;
    callback journal-open(string);
    callback journal-navigate(int);
    callback journal-shift(int);
    callback journal-view-mode(int);
    callback journal-today();
    callback journal-new-today();
    callback journal-close();
    callback journal-edit(string);
    callback journal-flush();
    callback journal-toggle-preview();
    callback journal-retry();
    callback journal-open-link(string);
    callback journal-add-image();
    callback journal-confirm-image();
    callback journal-cancel-image();
    callback journal-viewer-open(int);
    callback journal-viewer-prev();
    callback journal-viewer-next();
    callback journal-viewer-close();
    callback journal-viewer-delete(string);
    callback journal-image-delete(string);
    in property <string> page-title: "今日任务";
    in property <string> sidebar-date;
    in property <string> sidebar-weekday;
    in property <string> route-context;
    in property <string> route-debug;
    in property <bool> can-go-back: false;
    in property <bool> plan-detail: false;
    in property <bool> general-settings: false;
    in property <string> settings-section;
    in property <bool> task-preferences-enabled: false;
    in property <string> task-preferences-error;
    in property <int> task-sort-index;
    in property <bool> task-show-unscheduled: true;
    in property <bool> task-show-completed: true;
    private property <int> today-reveal-kind: -1;
    private property <int> today-reveal-version: 0;
    /// 0 读取配置中 / 1 可用 / 2 存储失败。
    in property <int> desktop-state: 0;
    in property <string> storage-error-message;
    in property <string> storage-error-log-id;
    in property <string> entry-mode: "ball";
    in property <bool> entry-available: false;
    in property <string> close-behavior: "entry";
    in property <string> theme-mode: "system";
    in property <string> week-start: "monday";
    in property <bool> system-dark: false;
    in property <bool> system-theme-available: true;
    in property <bool> desktop-busy: false;
    in property <string> show-hotkey-status: "正在注册…";
    in property <[ToastData]> toasts;
    /// SHELL-02 §6：对话框状态由 `feedback::dialog` 的队列计算后写入。
    in property <bool> dialog-visible: false;
    in property <DialogData> dialog;
    in property <bool> dialog-focus-cancel: true;
    in property <bool> dialog-scrim-closable: true;
    in property <int> dialog-token: 0;
    /// SHELL-02 §5：当前页横幅，由 `feedback::banner` 选出最高级的一条。
    in property <bool> banner-visible: false;
    in property <BannerData> banner;
    callback route_action(string);
    callback toast_hover(int, bool);
    callback toast_action(int);
    callback dialog_confirm();
    callback dialog_cancel();
    callback banner_action();
    callback banner_dismissed();
    /// 后台线程只能通过 event loop 唤醒此回调。
    callback desktop-wakeup();

    in property <[TodaySectionData]> today-sections;
    /// P4：隐藏时真正卸载页面实例，外壳可以暂时保留。
    in property <bool> today-mounted: false;
    in-out property <length> today-scroll-y: 0px;
    /// 0 首次加载 / 1 已加载 / 2 查询失败。
    in property <int> today-state: 0;
    in property <string> today-date;
    in property <int> today-open-count;
    in property <int> today-overdue-count;
    in property <int> today-completed-count;
    in property <string> today-error;
    in property <string> today-error-log-id;
    in property <bool> task-busy: false;
    in property <string> task-create-error;
    in-out property <string> task-quick-title;
    in property <bool> task-detail-visible: false;
    in property <bool> task-detail-loading: false;
    in property <string> task-detail-focus: "editor:title";
    in property <bool> task-editor-enabled: true;
    in property <bool> task-read-only: false;
    in property <string> task-selected-id;
    in property <string> task-save-label;
    in property <string> task-error;
    in property <string> task-context;
    in property <int> task-description-count;
    in-out property <string> task-title;
    in-out property <string> task-description;
    in-out property <string> task-start-date;
    in property <string> task-start-time;
    in-out property <string> task-due-date;
    in property <string> task-due-time;
    in property <Date> task-start-seed-date;
    in property <Date> task-due-seed-date;
    in property <int> task-start-seed-hour;
    in property <int> task-start-seed-minute;
    in property <int> task-due-seed-hour;
    in property <int> task-due-seed-minute;
    in property <[string]> task-hours;
    in property <[string]> task-minutes;
    in property <[string]> task-years;
    in property <Date> task-picker-today;
    out property <bool> task-picker-open: false;
    callback task-create(string);
    callback task-open(string);
    callback task-open-dates(string);
    callback task-toggle(string);
    callback task-delete(string);
    callback task-priority(string);
    callback task-focus-move(string, int);
    callback task-edit(string, string);
    callback task-set-status(string, int);
    callback task-datetime(string, Date, int, int);
    callback task-clear-datetime(string);
    pure callback task-calendar-month(int, int, Date) -> [CalendarDayData];
    pure callback task-calendar-day(Date, int) -> Date;
    pure callback task-calendar-month-move(Date, int) -> Date;
    pure callback task-calendar-select-month(Date, int, int) -> Date;
    pure callback task-date-label(string, int) -> string;
    callback task-flush();
    callback task-close();
    callback task-retry();
    callback task-reload();
    callback today-retry();
    callback today-section(int);
    callback today-more(int);

    changed task-detail-visible => { if (!root.task-detail-visible) { root.task-picker-open = false; } }

    public function focus-task-create() { ShellFocus.anchor = "today:quick"; ShellFocus.restore(); }
    public function focus-task-editor() {
        ShellFocus.anchor = root.task-read-only ? "editor:close" : root.task-detail-focus;
        ShellFocus.restore();
    }
    public function focus-task-row(id: string) {
        ShellFocus.anchor = "task:" + id;
        ShellFocus.restore();
    }
    public function restore-task-focus() { ShellFocus.restore(); }
    /// Q-SET-10：只响应用户的快捷恢复，正常查询不滚动或展开分组。
    public function reveal-task-section(kind: int) {
        if (root.current_page == "今日任务" && kind >= 0 && kind < 8) {
            root.today-reveal-kind = kind;
            root.today-reveal-version += 1;
        }
    }

    /// SHELL-02 §8.1 / D-SHELL-02：路由焦点落在内容区，不抢走模态焦点。
    public function focus-route-content() {
        if (!root.dialog-visible) {
            ShellFocus.anchor = "";
            workspace.focus();
        }
    }

    init => {
        shortcuts.focus();
    }

    // AC-SHELL-17 / SHELL-02 §8.4：对话框关闭后把焦点还给打开它的控件。
    // 锚点为空说明打开前焦点就在外壳上，直接回到外壳。
    changed dialog-visible => {
        if (!root.dialog-visible) {
            ShellFocus.restore();
        }
    }

    changed desktop-busy => {
        if (!root.desktop-busy && !root.dialog-visible) { ShellFocus.restore(); }
    }

    private property <int> restore-tick: ShellFocus.restore-tick;

    changed restore-tick => {
        if (ShellFocus.anchor == "") {
            shortcuts.focus();
        }
    }

    // 横幅关闭后它自己的按钮随之消失，锚点已无对应控件，把焦点交回外壳。
    changed banner-visible => {
        if (!root.banner-visible && (ShellFocus.anchor == "banner-close" || ShellFocus.anchor == "banner-action")) {
            ShellFocus.anchor = "";
            shortcuts.focus();
        }
    }

    private property <[PagePresentation]> pages: [
        {
            label: "今日任务",
            icon: @image-url("../../../ui/icons/today.svg"),
            description: "集中查看当天要做的事，逐项推进。\n任务列表与快速添加将在今日任务模块接入。",
            empty-title: "今天还没有任务",
            empty-description: "在下方输入框快速添加，按 Enter 保存。",
            empty-action: "",
        },
        {
            label: "日历",
            icon: @image-url("../../../ui/icons/calendar.svg"),
            description: "从时间维度查看和调整任务安排。\n月 / 周日历将在日历模块接入。",
            empty-title: "这一天还没有安排",
            empty-description: "点击「新建任务」为这一天添加任务。",
            empty-action: "新建任务",
        },
        {
            label: "小记",
            icon: @image-url("../../../ui/icons/notes.svg"),
            description: "快速记录临时想法，之后再整理。\n小记列表与编辑能力将在小记模块接入。",
            empty-title: "还没有小记",
            empty-description: "记录临时想法，之后可以转为任务。",
            empty-action: "写第一条",
        },
        {
            label: "日记",
            icon: @image-url("../../../ui/icons/journal.svg"),
            description: "按日期记录进展，留住每天的思考。\n日记编辑与回顾将在日记模块接入。",
            empty-title: "这一天还没有日记",
            empty-description: "写下今天的进展或感受，内容会自动保存。",
            empty-action: "开始写",
        },
        {
            label: "计划板",
            icon: @image-url("../../../ui/icons/plan.svg"),
            description: "将较大目标拆成阶段和任务。\n计划列表、路线图与任务树将在计划板模块接入。",
            empty-title: "还没有计划",
            empty-description: "把较大的目标拆成阶段和任务，跟踪整体进展。",
            empty-action: "新建计划",
        },
    ];
    private property <PageState> effective-state: root.desktop-state == 0 ? PageState.loading : root.desktop-state == 2 ? PageState.error : PageState.ready;
    private property <int> active-index: current_page == "日历" ? 1 : current_page == "小记" ? 2 : current_page == "日记" ? 3 : current_page == "计划板" ? 4 : 0;
    private property <image> settings-icon: @image-url("../../../ui/icons/settings.svg");

    // SHELL-02 §7.2: 应用级快捷键。子控件拒绝的按键会冒泡到这里，
    // 所以焦点在导航项上或窗口空白处时都能生效。
    shortcuts := FocusScope {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            // SHELL-02 §6.1：对话框打开期间应用级快捷键不得穿透。
            if (root.dialog-visible) {
                return reject;
            }
            if (event.text == Key.Escape && root.task-detail-visible && !root.task-picker-open) {
                root.task-close();
                return accept;
            }
            if (root.current_page == "日记" && !root.dialog-visible) {
                if (event.text == Key.Escape) {
                    if (root.journal-viewer-visible) { root.journal-viewer-close(); return accept; }
                    if (root.journal-editing) { root.journal-close(); return accept; }
                }
                if (root.journal-viewer-visible) {
                    if (event.text == Key.LeftArrow) { root.journal-viewer-prev(); return accept; }
                    if (event.text == Key.RightArrow) { root.journal-viewer-next(); return accept; }
                }
                if (!root.journal-editing) {
                    if (event.text == Key.LeftArrow) { root.journal-navigate(-1); return accept; }
                    if (event.text == Key.RightArrow) { root.journal-navigate(1); return accept; }
                    if (event.text == "t" || event.text == "T") { root.journal-today(); return accept; }
                }
            }
            if (!event.modifiers.control || event.modifiers.alt || event.modifiers.shift) {
                return reject;
            }
            if (event.text == "/" && root.current_page == "小记" && root.note-has-selection && !root.note-shortcut-blocked) {
                root.note-toggle-preview();
            } else if ((event.text == "s" || event.text == "S") && root.current_page == "小记" && root.note-has-selection && !root.note-create-open && root.note-rename-id == "") {
                root.note-flush();
            } else if ((event.text == "s" || event.text == "S") && root.current_page == "日记" && root.journal-editing) {
                root.journal-flush();
            } else if (event.text == "/" && root.current_page == "日记" && root.journal-editing) {
                root.journal-toggle-preview();
            } else if ((event.text == "n" || event.text == "N") && root.current_page == "今日任务") {
                root.focus-task-create();
            } else if (event.text == "1") {
                root.route_action("navigate:今日任务");
            } else if (event.text == "2") {
                root.route_action("navigate:日历");
            } else if (event.text == "3") {
                root.route_action("navigate:小记");
            } else if (event.text == "4") {
                root.route_action("navigate:日记");
            } else if (event.text == "5") {
                root.route_action("navigate:计划板");
            } else if (event.text == ",") {
                root.route_action("navigate:设置");
            } else if (event.text == "w" || event.text == "W") {
                root.route_action("desktop:close");
            } else {
                return reject;
            }
            return accept;
        }

        TouchArea { clicked => { if (root.current_page == "小记") { shortcuts.focus(); } } }

        if root.custom-titlebar: TitleBar {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.caption-height;
            maximized: root.window-maximized;
            active: root.window-active;
            minimize => { root.route_action("desktop:minimize"); }
            maximize => { root.route_action("desktop:maximize"); }
            close => { root.route_action("desktop:close"); }
        }

        HorizontalLayout {
            x: 0px;
            y: root.caption-height;
            width: parent.width;
            height: parent.height - self.y;
            spacing: 0px;
            padding: 0px;

            Rectangle {
                width: 208px;
                background: ShellPalette.canvas;

                VerticalLayout {
                    spacing: 0px;
                    padding: 0px;

                    SidebarDate {
                        date-label: root.sidebar-date;
                        weekday-label: root.sidebar-weekday;
                    }

                    VerticalLayout {
                        height: 232px;
                        padding-top: 12px;
                        padding-bottom: 4px;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 4px;

                        for page in root.pages: ShellControl {
                            navigation: true;
                            label: page.label;
                            icon: page.icon;
                            focus-key: "nav:" + page.label;
                            selected: root.current_page == page.label;
                            activated => {
                                root.route_action("navigate:" + page.label);
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }

                    Rectangle {
                        height: 1px;
                        background: transparent;
                        Rectangle {
                            x: 12px;
                            width: parent.width - 24px;
                            height: 1px;
                            background: ShellPalette.border;
                        }
                    }

                    Rectangle {
                        height: 64px;
                        background: transparent;
                        ShellControl {
                            x: 12px;
                            y: 12px;
                            // 让出右侧 40px，主题按钮与设置行垂直居中且不重叠。
                            width: parent.width - 64px;
                            navigation: true;
                            label: "设置";
                            icon: root.settings-icon;
                            focus-key: "nav:设置";
                            selected: root.current_page == "设置";
                            activated => {
                                root.route_action("navigate:设置");
                            }
                        }
                        // SET-02 / SHELL-01：所有页面都能在「设置」行右侧直接切换主题。
                        ThemeSwitch {
                            x: parent.width - 48px;
                            y: 14px;
                            mode: root.theme-mode;
                            enabled: root.desktop-state == 1 && !root.desktop-busy && !root.dialog-visible;
                            cycle => { root.route_action("desktop:theme:cycle"); }
                        }
                    }
                }

                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: parent.height;
                    background: ShellPalette.border;
                }
            }

            workspace := FocusScope {
                horizontal-stretch: 1;
                focus-on-tab-navigation: false;
                accessible-role: text;
                accessible-label: root.page-title + "内容区";

                PageFrame {
                    width: parent.width;
                    height: parent.height;
                    can-go-back: root.can-go-back;
                    back-enabled: !root.dialog-visible;
                    back-focus-key: root.plan-detail ? "plan-back" : "settings-back";
                    back => { root.route_action("back"); }
                    state: root.effective-state;
                    empty-icon: root.pages[root.active-index].icon;
                    empty-title: root.plan-detail ? "这个计划还没有阶段" : root.pages[root.active-index].empty-title;
                    empty-description: root.plan-detail ? "添加阶段来组织任务，或直接在计划下添加任务。" : root.pages[root.active-index].empty-description;
                    empty-action: root.plan-detail ? "添加阶段" : root.pages[root.active-index].empty-action;
                    error-title: "无法加载" + root.page-title;
                    error-message: root.desktop-state == 2 ? root.storage-error-message : "请重试。如果问题持续出现，请提供下方的日志 ID。";
                    error-log-id: root.desktop-state == 2 ? root.storage-error-log-id : "preview-0000-0000";
                    read-only-text: "所属计划已归档，仅供查看。";
                    banner-visible: root.banner-visible;
                    banner: root.banner;
                    banner-action => {
                        root.banner_action();
                    }
                    banner-dismissed => {
                        root.banner_dismissed();
                    }
                    retry => {
                        if (root.desktop-state == 2) {
                            root.route_action("desktop:retry");
                        }
                        // 重试按钮随错误块消失，把焦点交回外壳，快捷键才不会失效。
                        shortcuts.focus();
                    }

                    if root.current_page == "设置": SettingsWorkspace {
                        section: root.settings-section;
                        enabled: !root.desktop-busy && !root.dialog-visible;
                        selected(section) => { root.route_action("navigate:设置?section=" + section); }
                        if root.general-settings: GeneralSettings {
                            entry-mode: root.entry-mode;
                            entry-available: root.entry-available;
                            close-behavior: root.close-behavior;
                            week-start: root.week-start;
                            busy: root.desktop-busy;
                            hotkey-status: root.show-hotkey-status;
                            action(value) => { root.route_action(value); }
                        }
                        if root.settings-section == "task-preferences": TaskPreferences {
                            sort-index: root.task-sort-index;
                            show-unscheduled: root.task-show-unscheduled;
                            show-completed: root.task-show-completed;
                            enabled: root.task-preferences-enabled && !root.dialog-visible;
                            busy: root.desktop-busy;
                            error-message: root.task-preferences-error;
                            action(value) => { root.route_action(value); }
                        }
                        if !root.general-settings && root.settings-section != "task-preferences": PagePlaceholder {
                            icon: root.settings-icon;
                            title: root.route-context;
                            description: "此设置分组尚未接入。";
                        }
                    }
                    if root.current_page == "今日任务" && root.today-mounted: today-page := TodayPage {
                        sections: root.today-sections;
                        state: root.today-state;
                        busy: root.task-busy;
                        enabled: root.desktop-state == 1 && !root.desktop-busy && !root.dialog-visible;
                        open-count: root.today-open-count;
                        overdue-count: root.today-overdue-count;
                        completed-count: root.today-completed-count;
                        selected-id: root.task-selected-id;
                        error-message: root.today-error;
                        error-log-id: root.today-error-log-id;
                        create-error: root.task-create-error;
                        quick-title <=> root.task-quick-title;
                        scroll-y <=> root.today-scroll-y;
                        reveal-kind <=> root.today-reveal-kind;
                        reveal-version: root.today-reveal-version;
                        created(value) => { root.task-create(value); }
                        opened(id) => { root.task-open(id); }
                        dates-requested(id) => { root.task-open-dates(id); }
                        toggled(id) => { root.task-toggle(id); }
                        deleted(id) => { root.task-delete(id); }
                        priority-changed(id) => { root.task-priority(id); }
                        status-changed(id, index) => { root.task-set-status(id, index); }
                        focus-moved(id, direction) => { root.task-focus-move(id, direction); }
                        section-toggled(kind) => { root.today-section(kind); }
                        more(kind) => { root.today-more(kind); }
                        retry => { root.today-retry(); }
                        escaped => { root.focus-route-content(); }
                    }
                    if root.current_page == "日历": CalendarPage {
                        heading: root.calendar-heading;
                        selected-label: root.calendar-selected-label;
                        selected-context: root.calendar-selected-context;
                        panel-message: root.calendar-panel-message;
                        panel-sections: root.calendar-panel-sections;
                        error-message: root.calendar-error;
                        weekdays: root.calendar-weekdays;
                        days: root.calendar-days;
                        week-mode: root.calendar-week-mode;
                        panel-open: root.calendar-panel-open;
                        compact: root.width < 1280px;
                        action(value) => { root.calendar-action(value); }
                        select-date(value) => { root.calendar-select-date(value); }
                    }
                    if root.current_page == "小记": NotesPage {
                        changed shortcut-blocked => { root.note-shortcut-blocked = self.shortcut-blocked; }
                        rows: root.note-rows; total: root.note-total; selected-id: root.note-selected-id;
                        current-name: root.note-current-name; selected-path: root.note-selected-path;
                        can-back: root.note-can-back; can-forward: root.note-can-forward; can-parent: root.note-can-parent;
                        reveal-index: root.note-reveal-index; reveal-tick: root.note-reveal-tick;
                        error: root.note-error; save-label: root.note-save-label; has-selection: root.note-has-selection;
                        content <=> root.note-content;
                        create-name <=> root.note-create-name; create-error: root.note-create-error; create-busy: root.note-create-busy;
                        create-open <=> root.note-create-open; created-date: root.note-created-date; updated-date: root.note-updated-date;
                        create-folder <=> root.note-create-folder; create-path: root.note-create-path;
                        rename-id: root.note-rename-id; rename-name <=> root.note-rename-name; rename-error: root.note-rename-error;
                        undo-visible: root.note-undo-visible;
                        create(name) => { root.note-create(name); }
                        create-start(id, folder) => { root.note-create-start(id, folder); }
                        preview-mode: root.note-preview-mode; preview-blocks: root.note-preview-blocks; preview-warning: root.note-preview-warning;
                        opened(id) => { root.note-open(id); }
                        selected-entry(id) => { root.note-select-entry(id); }
                        toggle-folder(id) => { root.note-toggle-folder(id); }
                        navigate(direction) => { root.note-navigate(direction); }
                        rename-start(id) => { root.note-rename-start(id); }
                        rename-submit(name) => { root.note-rename-submit(name); }
                        rename-cancel => { root.note-rename-cancel(); }
                        delete-entry(id) => { root.note-delete(id); }
                        undo => { root.note-undo(); }
                        move-entry(id, destination) => { root.note-move(id, destination); }
                        edited(value) => { root.note-edit(value); }
                        flush => { root.note-flush(); }
                        discard => { root.note-discard(); }
                        toggle-preview => { root.note-toggle-preview(); }
                        open-link(url) => { root.note-open-link(url); }
                    }
                    if root.current_page == "日记": JournalPage {
                        rows: root.journal-rows;
                        period-label: root.journal-period-label;
                        week-mode: root.journal-week-mode;
                        empty: root.journal-empty;
                        has-today: root.journal-has-today;
                        date-label: root.journal-date-label;
                        selected-date: root.journal-selected-date;
                        editing: root.journal-editing;
                        content <=> root.journal-content;
                        save-label: root.journal-save-label;
                        error: root.journal-error;
                        preview-mode: root.journal-preview-mode;
                        preview-blocks: root.journal-preview-blocks;
                        attachments: root.journal-attachments;
                        image-usage: root.journal-image-usage;
                        add-image-busy: root.journal-add-image-busy;
                        pending-image: root.journal-pending-image;
                        pending-image-label: root.journal-pending-image-label;
                        viewer-visible: root.journal-viewer-visible;
                        viewer-image: root.journal-viewer-image;
                        viewer-title: root.journal-viewer-title;
                        viewer-loading: root.journal-viewer-loading;
                        viewer-index: root.journal-viewer-index;
                        open(date) => { root.journal-open(date); }
                        navigate(delta) => { root.journal-navigate(delta); }
                        shift(delta) => { root.journal-shift(delta); }
                        view-mode(mode) => { root.journal-view-mode(mode); }
                        today => { root.journal-today(); }
                        new-today => { root.journal-new-today(); }
                        close => { root.journal-close(); }
                        edited(value) => { root.journal-edit(value); }
                        flush => { root.journal-flush(); }
                        toggle-preview => { root.journal-toggle-preview(); }
                        retry => { root.journal-retry(); }
                        open-link(url) => { root.journal-open-link(url); }
                        add-image => { root.journal-add-image(); }
                        confirm-image => { root.journal-confirm-image(); }
                        cancel-image => { root.journal-cancel-image(); }
                        viewer-open(index) => { root.journal-viewer-open(index); }
                        viewer-prev => { root.journal-viewer-prev(); }
                        viewer-next => { root.journal-viewer-next(); }
                        viewer-close => { root.journal-viewer-close(); }
                        viewer-delete(id) => { root.journal-viewer-delete(id); }
                        image-delete(id) => { root.journal-image-delete(id); }
                    }
                    if root.current_page != "设置" && root.current_page != "今日任务" && root.current_page != "日历" && root.current_page != "小记" && root.current_page != "日记": PagePlaceholder {
                        icon: root.current_page == "设置" ? root.settings-icon : root.pages[root.active-index].icon;
                        title: root.page-title + "工作区";
                        description: root.current_page == "设置" ? "外观、快捷键和数据管理将在这里统一设置。\n点击内容区返回，可回到进入设置前的页面。" : root.pages[root.active-index].description;
                    }
                }

            }
        }

        // 首次外部点击只触发保存关闭，不穿透到下层按钮；内部选择弹层不算外部。
        if root.task-detail-visible: detail-outside := TouchArea {
            x: 0px;
            y: root.caption-height;
            width: parent.width;
            height: parent.height - self.y;
            enabled: !root.dialog-visible && !root.task-picker-open;
            clicked => { root.task-close(); }
        }

        if root.task-detail-visible: task-drawer := TaskDrawer {
            x: parent.width - 400px;
            y: root.caption-height;
            width: 400px;
            height: parent.height - self.y;
            loading: root.task-detail-loading;
            enabled: root.task-editor-enabled && !root.dialog-visible && !root.desktop-busy;
            read-only: root.task-read-only;
            title <=> root.task-title;
            description <=> root.task-description;
            start-date <=> root.task-start-date;
            start-time: root.task-start-time;
            due-date <=> root.task-due-date;
            due-time: root.task-due-time;
            start-seed-date: root.task-start-seed-date;
            due-seed-date: root.task-due-seed-date;
            start-seed-hour: root.task-start-seed-hour;
            start-seed-minute: root.task-start-seed-minute;
            due-seed-hour: root.task-due-seed-hour;
            due-seed-minute: root.task-due-seed-minute;
            hours: root.task-hours;
            minutes: root.task-minutes;
            years: root.task-years;
            picker-today: root.task-picker-today;
            description-count: root.task-description-count;
            save-label: root.task-save-label;
            error-message: root.task-error;
            context-label: root.task-context;
            edited(field, value) => { root.task-edit(field, value); }
            datetime-selected(field, date, hour, minute) => { root.task-datetime(field, date, hour, minute); }
            datetime-cleared(field) => { root.task-clear-datetime(field); }
            picker-changed(open) => { root.task-picker-open = open; }
            calendar-month(year, month, today) => { return root.task-calendar-month(year, month, today); }
            calendar-day(date, offset) => { return root.task-calendar-day(date, offset); }
            calendar-month-move(date, offset) => { return root.task-calendar-month-move(date, offset); }
            calendar-select-month(date, year, month) => { return root.task-calendar-select-month(date, year, month); }
            date-label(date, year) => { return root.task-date-label(date, year); }
            flush => { root.task-flush(); }
            closed => { root.task-close(); }
            deleted => { root.task-delete(root.task-selected-id); }
            retry => { root.task-retry(); }
            reload => { root.task-reload(); }
        }

        // SHELL-02 §3.1：Toast 居中于内容区，距底 24。
        ToastHost {
            x: 208px;
            y: root.caption-height;
            width: parent.width - 208px;
            height: parent.height - self.y;
            bottom-inset: 24px;
            toasts: root.toasts;
            hover-changed(id, hovered) => {
                root.toast_hover(id, hovered);
            }
            action(id) => {
                root.toast_action(id);
            }
        }

        // SHELL-02 §6：对话框覆盖整个窗口，在 Toast 之上，打开时抢走焦点。
        DialogHost {
            x: 0px;
            y: root.caption-height;
            width: parent.width;
            height: parent.height - self.y;
            open: root.dialog-visible;
            token: root.dialog-token;
            data: root.dialog;
            focus-cancel: root.dialog-focus-cancel;
            scrim-closable: root.dialog-scrim-closable;
            confirmed => {
                root.dialog_confirm();
            }
            cancelled => {
                root.dialog_cancel();
            }
        }
    }
    // 原生圆角裁切整个窗口；描边只补充边缘辨识，不接收输入或占用布局空间。
    window-outline := WindowOutline {
        x: 0px; y: 0px;
        width: parent.width; height: parent.height;
        visible: root.custom-titlebar && !root.window-maximized;
    }
}
