import { ShellPalette } from "palette.slint";
import { ShellControl } from "components/shell-control.slint";
import { PagePlaceholder } from "components/page-placeholder.slint";

struct PagePresentation {
    label: string,
    icon: image,
    description: string,
}

export component MainWindow inherits Window {
    title: "FastNote";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1024px;
    min-height: 680px;
    default-font-family: "Microsoft YaHei UI";
    default-font-size: 14px;
    background: ShellPalette.canvas;

    in property <string> current_page: "今日任务";
    callback route_action(string);

    private property <[PagePresentation]> pages: [
        {
            label: "今日任务",
            icon: @image-url("../../../ui/icons/today.svg"),
            description: "集中查看当天要做的事，逐项推进。\n任务列表与快速添加将在今日任务模块接入。",
        },
        {
            label: "日历",
            icon: @image-url("../../../ui/icons/calendar.svg"),
            description: "从时间维度查看和调整任务安排。\n月 / 周日历将在日历模块接入。",
        },
        {
            label: "小记",
            icon: @image-url("../../../ui/icons/notes.svg"),
            description: "快速记录临时想法，之后再整理。\n小记列表与编辑能力将在小记模块接入。",
        },
        {
            label: "日记",
            icon: @image-url("../../../ui/icons/journal.svg"),
            description: "按日期记录进展，留住每天的思考。\n日记编辑与回顾将在日记模块接入。",
        },
        {
            label: "计划板",
            icon: @image-url("../../../ui/icons/plan.svg"),
            description: "将较大目标拆成阶段和任务。\n计划列表、路线图与任务树将在计划板模块接入。",
        },
    ];
    private property <int> active-index: current_page == "日历" ? 1 : current_page == "小记" ? 2 : current_page == "日记" ? 3 : current_page == "计划板" ? 4 : 0;
    private property <image> settings-icon: @image-url("../../../ui/icons/settings.svg");

    HorizontalLayout {
        spacing: 0px;
        padding: 0px;

        Rectangle {
            width: 208px;
            background: ShellPalette.canvas;

            VerticalLayout {
                spacing: 0px;
                padding: 0px;

                Rectangle {
                    height: 64px;
                    background: transparent;
                    Text {
                        x: 20px;
                        y: 20px;
                        height: 24px;
                        text: "FastNote";
                        font-size: 16px;
                        font-weight: 600;
                        color: ShellPalette.text-primary;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    height: 232px;
                    padding-top: 12px;
                    padding-bottom: 4px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 4px;

                    for page in root.pages: ShellControl {
                        navigation: true;
                        label: page.label;
                        icon: page.icon;
                        selected: root.current_page == page.label;
                        activated => {
                            root.route_action("navigate:" + page.label);
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; background: transparent; }

                Rectangle {
                    height: 1px;
                    background: transparent;
                    Rectangle {
                        x: 12px;
                        width: parent.width - 24px;
                        height: 1px;
                        background: ShellPalette.border;
                    }
                }

                Rectangle {
                    height: 64px;
                    background: transparent;
                    ShellControl {
                        x: 12px;
                        y: 12px;
                        width: parent.width - 24px;
                        navigation: true;
                        label: "设置";
                        icon: root.settings-icon;
                        selected: root.current_page == "设置";
                        activated => {
                            root.route_action("navigate:设置");
                        }
                    }
                }
            }

            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: parent.height;
                background: ShellPalette.border;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0px;
            padding: 0px;

            Rectangle {
                height: 64px;
                background: ShellPalette.canvas;

                Text {
                    x: 24px;
                    y: 18px;
                    height: 28px;
                    text: root.current_page;
                    font-size: 20px;
                    font-weight: 600;
                    color: ShellPalette.text-primary;
                    vertical-alignment: center;
                }

                if root.current_page != "设置": Text {
                    x: parent.width - self.width - 24px;
                    y: 24px;
                    width: 60px;
                    height: 16px;
                    text: "外壳预览";
                    font-size: 12px;
                    color: ShellPalette.text-secondary;
                    horizontal-alignment: right;
                }

                if root.current_page == "设置": ShellControl {
                    x: parent.width - self.width - 24px;
                    y: 16px;
                    width: 92px;
                    label: "返回";
                    icon: @image-url("../../../ui/icons/arrow-left.svg");
                    activated => {
                        root.route_action("back");
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    width: parent.width;
                    background: ShellPalette.border;
                }
            }

            Rectangle {
                vertical-stretch: 1;
                background: ShellPalette.canvas;

                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: 24px;
                    width: min(1200px, parent.width - 48px);
                    height: parent.height - 48px;
                    border-radius: 10px;
                    border-width: 1px;
                    border-color: ShellPalette.border;
                    background: ShellPalette.surface;

                    PagePlaceholder {
                        x: (parent.width - self.width) / 2;
                        y: max(24px, (parent.height - self.height) / 2 - 16px);
                        width: min(480px, parent.width - 48px);
                        icon: root.current_page == "设置" ? root.settings-icon : root.pages[root.active-index].icon;
                        title: root.current_page + "工作区";
                        description: root.current_page == "设置" ? "外观、快捷键和数据管理将在这里统一设置。\n点击右上角返回，可回到进入设置前的页面。" : root.pages[root.active-index].description;
                    }
                }
            }
        }
    }
}
