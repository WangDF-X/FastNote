import { LineEdit } from "std-widgets.slint";
import { ShellPalette } from "../palette.slint";
import { ShellFocus } from "../shell-focus.slint";
import { NoteRowData } from "types.slint";

/// 选择、展开、右键和原位重命名使用独立命中区域。
export component NoteTreeRow inherits Rectangle {
    in property <NoteRowData> data;
    in property <bool> selected;
    in property <bool> enabled;
    in property <bool> renaming;
    in property <bool> busy;
    in-out property <string> rename-name;
    in property <string> rename-error;
    callback selected-entry();
    callback opened();
    callback toggled();
    callback context-requested(length, length);
    callback rename-start();
    callback rename-submit(string);
    callback rename-cancel();
    callback delete-requested();
    callback focus-moved(int);
    callback dropped(length);
    private property <length> start-y;
    private property <bool> dragged: false;
    private property <length> indent: root.data.depth * 16px;
    height: root.renaming && root.rename-error != "" ? 44px + error-text.preferred-height : 36px;
    border-radius: 6px;
    background: root.selected ? ShellPalette.selected : root.enabled && touch.has-hover ? ShellPalette.hover : transparent;
    accessible-role: button; accessible-label: root.data.title;
    accessible-action-default => { if (root.enabled) { if (root.data.is-folder) { root.selected-entry(); } else { root.opened(); } } }
    forward-focus: keys;
    changed selected => { if (root.selected && root.enabled) { keys.focus(); } }

    keys := FocusScope {
        height: 36px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return) { if (root.data.is-folder) { root.toggled(); } else { root.opened(); } return accept; }
            if (event.text == Key.F2) { root.rename-start(); return accept; }
            if (event.text == Key.Delete) { root.delete-requested(); return accept; }
            if (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) { root.context-requested(root.indent + 24px, 32px); return accept; }
            if (event.text == Key.UpArrow) { root.focus-moved(-1); return accept; }
            if (event.text == Key.DownArrow) { root.focus-moved(1); return accept; }
            if (root.data.is-folder && ((event.text == Key.LeftArrow && root.data.expanded) || (event.text == Key.RightArrow && !root.data.expanded))) { root.toggled(); return accept; }
            return reject;
        }
        touch := TouchArea {
            enabled: root.enabled;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) { root.start-y = self.mouse-y; root.dragged = false; }
                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) { keys.focus(); root.context-requested(self.mouse-x, self.mouse-y); }
                if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.dragged && self.mouse-x >= 0px && self.mouse-x < self.width) { root.dropped(self.mouse-y); }
                if (event.kind == PointerEventKind.cancel) { root.dragged = false; }
            }
            moved => { if (self.pressed && abs(self.mouse-y - root.start-y) > 8px) { root.dragged = true; } }
            clicked => { if (!root.dragged) { keys.focus(); if (root.data.is-folder) { root.selected-entry(); } else { root.opened(); } } }
        }
    }
    if root.data.is-folder: Rectangle {
        x: root.indent + 2px; y: 4px; width: 28px; height: 28px; border-radius: 4px;
        background: root.enabled && expand.has-hover ? ShellPalette.subtle : transparent;
        Image {
            x: 7px; y: 7px; width: 14px; height: 14px;
            source: @image-url("../../../../ui/icons/chevron-right.svg"); colorize: ShellPalette.text-secondary;
            transform-rotation: root.data.expanded ? 90deg : 0deg;
            transform-origin: { x: 7px, y: 7px };
        }
        expand := TouchArea { enabled: root.enabled; clicked => { root.toggled(); } }
    }
    Image {
        x: root.indent + 32px; y: 10px; width: 16px; height: 16px;
        source: root.data.is-folder ? @image-url("../../../../ui/icons/folder.svg") : @image-url("../../../../ui/icons/notes.svg");
        colorize: root.data.is-folder ? ShellPalette.text-secondary : ShellPalette.text-tertiary;
        accessible-role: none;
    }
    if !root.renaming: Text {
        x: root.indent + 54px; width: parent.width - self.x - 8px; height: 36px;
        text: root.data.title; font-size: 14px; font-weight: root.data.is-folder ? 500 : 400;
        color: ShellPalette.text-primary; overflow: elide; vertical-alignment: center;
    }
    if root.renaming: Rectangle {
        x: root.indent + 50px; y: 2px; width: parent.width - self.x - 4px; height: 32px;
        clip: true;
        name := LineEdit {
            width: parent.width; height: parent.height;
            text <=> root.rename-name; enabled: !root.busy; font-size: 14px;
            accessible-label: "重命名 " + root.data.title;
            init => { self.focus(); self.select-all(); }
            accepted(value) => { root.rename-submit(value); }
            key-pressed(event) => { if (event.text == Key.Escape) { root.rename-cancel(); return accept; } return reject; }
        }
        if !ShellFocus.show-indicators: Rectangle {
            x: 4px; y: parent.height - 2px; width: parent.width - 8px; height: 2px;
            background: ShellPalette.surface; accessible-role: none;
        }
        Rectangle {
            border-radius: 4px; border-width: 1px;
            border-color: root.rename-error != "" ? ShellPalette.danger : ShellPalette.border;
            background: transparent; accessible-role: none;
        }
    }
    error-text := Text {
        visible: root.renaming && root.rename-error != "";
        x: root.indent + 50px; y: 40px; width: parent.width - self.x - 4px;
        text: root.rename-error; color: ShellPalette.danger; font-size: 12px; wrap: word-wrap;
    }
}
